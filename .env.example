# Kopioi tämä nimelle .env ja täytä arvot (tai aseta ympäristömuuttujina hostissa).
# Telegram-botin token, jonka saat @BotFatherilta:
TELEGRAM_BOT_TOKEN=123456789:AA...your-token...

# Vastaanottajien chat-id:t pilkulla eroteltuna (sinä + vaimo, tai yksi ryhmächat):
TELEGRAM_CHAT_IDS=11111111,22222222
